{
  "order": 7,
  "slug": "borrowed-umbrella-bn",
  "title": "ধার করা ছাতা",
  "theme": "Umbrella",
  "year": "2026",
  "stanzas": [
    [
      "চায়ের দোকানের দেওয়ালে",
      "একটা ছাতা রাখা ছিল,",
      "হাতলে খোদাই করা এক নাম,",
      "রং উঠে গেছে ধুলায়।"
    ],
    [
      "বৃষ্টি নামলে দোকানদার বলল,",
      "নিয়ে যাও, ভাড়া লাগবে না,",
      "শুধু ভেজা ছাতা ভাঁজ কোরো না,",
      "শুকনো করে ফিরিয়ে দিও।"
    ],
    [
      "রিকশার হুডের নিচে",
      "ছাতাটা রাখলাম কোলে,",
      "শহরের সব আলো ভিজে গেল,",
      "আমার পায়ের কাছে জমল জল।"
    ],
    [
      "ঘরে এনে খুলে মেলালাম,",
      "বারোটা শিক ভেজা, একটার আগা বাঁকা,",
      "ভেজা কাপড়ের গন্ধে মনে হল",
      "কেউ এই ছাতায় অনেক বর্ষা কাটিয়েছে।"
    ],
    [
      "তিন মাস পরে ফিরিয়ে দিতে গেলাম,",
      "দোকানে নতুন ছাতা ঝুলছে,",
      "দোকানদার হাতলটা ছুঁয়ে দেখল,",
      "তারপর বলল, রেখে যাও, বৃষ্টি আসছে।"
    ]
  ]
}
