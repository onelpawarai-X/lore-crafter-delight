{
  "order": 9,
  "slug": "borrowed-umbrella-tr",
  "title": "Mavi Bantlı Şemsiye",
  "theme": "Umbrella",
  "year": "2026",
  "stanzas": [
    [
      "Şemsiyeyi kapıcı verdi,",
      "sapında mavi bir bant,",
      "\"yağmur dinsin, getirirsin\" dedi.",
      "Getirmedim. İki kış geçti."
    ],
    [
      "Kadıköy'de çay soğurken",
      "şemsiye kolumun altında kapalı durdu,",
      "ıslak kaldırımda simit tezgâhı,",
      "buharı geçen otobüsle dağıldı."
    ],
    [
      "Evin koridorunda açtım bir akşam,",
      "telleri paslanmış, biri eğri,",
      "ıslak bez kokusu sindi odalara,",
      "sanki biri bu şemsiyeyle çok yürümüş."
    ],
    [
      "Martta götürmeye niyetlendim,",
      "apartmanın kapısına kadar geldim,",
      "kapıcı dairesinde televizyon açıktı,",
      "döndüm, şemsiye hâlâ elimde."
    ],
    [
      "Geçen ay kapıcı taşınmış,",
      "yerine kimse bakmıyor artık,",
      "şemsiye askıda duruyor, mavi bantlı,",
      "yağmur başlayınca açıyorum."
    ]
  ]
}
